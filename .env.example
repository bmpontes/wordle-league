# Copie para .env e ajuste:  cp .env.example .env
# NUNCA coloque o ficheiro .env no controlo de versões.

# --- Rede ---
# Porta publicada no anfitrião (Docker Compose).
APP_PORT=3000
# Porta interna do servidor Node (fora do Docker).
PORT=3000
HOST=0.0.0.0

# --- Dados ---
# Diretório persistente (BD SQLite, segredo de sessão, backups). No Docker é /app/data.
# DATA_DIR=./data
# DB_FILE=./data/wordle.sqlite

# Fuso horário do desafio diário (não alterar salvo indicação em contrário).
APP_TIMEZONE=Europe/Lisbon

# --- Sessões ---
# Segredo das sessões (mín. 32 caracteres). Se ficar vazio, é gerado um segredo
# aleatório e guardado em DATA_DIR/.session_secret no primeiro arranque.
# Para gerar: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
# true quando a aplicação é servida por HTTPS (cookies "Secure", HSTS).
COOKIE_SECURE=false
# 1 quando estiver atrás de um reverse proxy (ex.: o Nginx do docker-compose).
TRUST_PROXY=0

# --- Limitação de logins falhados (por conta; por IP o limite é 4x maior) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Administrador inicial ---
# Usado APENAS no arranque e APENAS se ainda não existir nenhum administrador.
# Depois de criado, apague ADMIN_PASSWORD deste ficheiro e reinicie.
# Alternativa recomendada: deixar vazio e executar "npm run create-admin".
ADMIN_USERNAME=
ADMIN_DISPLAY_NAME=
ADMIN_PASSWORD=

# --- Diversos ---
NODE_ENV=production
LOG_REQUESTS=true

# --- Nginx opcional (docker compose --profile proxy up -d) ---
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
