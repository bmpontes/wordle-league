{
  "name": "forense-wordle-league",
  "version": "1.4.0",
  "private": true,
  "description": "Forense Wordle League — jogo de palavras diário interno (COCIBER, Secção de Investigação Digital)",
  "repository": {
    "type": "git",
    "url": "https://github.com/bmpontes/FOR_Wordle_League.git"
  },
  "homepage": "https://github.com/bmpontes/FOR_Wordle_League#readme",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "restore": "node --env-file-if-exists=.env scripts/restore.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\""
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "better-sqlite3": "^12.11.1",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
